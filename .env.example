# Backend Selection: local or snowflake
BACKEND=local

# Local DB Configuration
DUCKDB_PATH=data/pulseops.duckdb
DATA_DIR=data

# Prediction & Alert Thresholds
RISK_THRESHOLD=0.65
ALERT_WINDOW_HOURS=72

# Snowflake Credentials (for PRD 2)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=PULSEOPS_PROD
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_WAREHOUSE=PULSEOPS_XS_WH
SNOWFLAKE_ROLE=PULSEOPS_ADMIN
